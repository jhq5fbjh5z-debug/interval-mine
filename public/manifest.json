{
  "manifest_version": 3,
  "name": "Interval Mine",
  "description": "Elegant interval timer — switch tasks smoothly and maintain flow",
  "version": "0.1.0",
  "permissions": ["alarms", "notifications", "storage"],
  "action": {
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
